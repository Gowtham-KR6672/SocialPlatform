# SocialDashboard V28 — environment variables
# Copy to your host (Render → Environment). Leave the online ones UNSET to run
# locally exactly like before (SQLite + local uploads + Ollama).

# --- Always set in production -------------------------------------------------
SECRET_KEY=change-me-to-a-long-random-string

# --- Database: set to use Supabase Postgres instead of local SQLite ----------
# Use the Supabase "Connection pooling" string (Transaction mode, port 6543).
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# --- File storage: set all three to store uploads in Supabase Storage --------
# Create a PUBLIC bucket named "uploads" in Supabase → Storage.
# SUPABASE_URL=https://<ref>.supabase.co
# SUPABASE_SERVICE_KEY=<service_role key from Supabase → Settings → API>
# SUPABASE_BUCKET=uploads

# --- AI: set to default AI features to the Claude API (no local model) --------
# CLAUDE_API_KEY=sk-ant-...

# --- Optional overrides -------------------------------------------------------
# HOST=0.0.0.0
# PORT=5000
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen3-vl:8b
