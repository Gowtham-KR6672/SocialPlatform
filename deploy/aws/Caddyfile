# HTTPS reverse proxy for the app. {$DOMAIN} comes from /etc/socialplatform/app.env.
# Caddy gets and renews the certificate itself once the domain's DNS points here.
{$DOMAIN} {
	encode gzip

	# video uploads up to the app's 512 MB limit
	request_body {
		max_size 520MB
	}

	reverse_proxy app:5000 {
		transport http {
			read_timeout 300s
			write_timeout 300s
		}
	}
}
