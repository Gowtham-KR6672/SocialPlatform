# Runtime data — never commit these (they're recreated at runtime)
data/
uploads/*
!uploads/.gitkeep
*.db
*.db-wal
*.db-shm

# Python
__pycache__/
*.pyc
.venv/
venv/

# Local env
.env

# mobile app build output (sources are committed)
mobile/node_modules/
mobile/android/.gradle/
mobile/android/build/
mobile/android/app/build/
mobile/android/local.properties
mobile/android/capacitor-cordova-android-plugins/build/
mobile/ios/App/build/
mobile/ios/DerivedData/
*.keystore
*.jks
mobile/dist/

# Firebase (push notifications): app config and the server key stay out of git
mobile/android/app/google-services.json
mobile/ios/App/App/GoogleService-Info.plist
*firebase-adminsdk*.json
